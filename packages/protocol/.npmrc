# npm's peer resolver cannot build an ideal tree for this dependency set. viem pulls abitype,
# whose peer range is "typescript >=5.0.4", and TypeScript 7 satisfies that while this package
# pins the 5.x line that typescript-eslint supports. Arborist walks that conflict into a null
# node and dies with "Cannot read properties of null (reading 'edgesOut')" before it writes a
# single file. Resolving peers the old way skips the walk and produces a correct tree.
#
# Everything here is a devDependency, the package itself ships with zero runtime dependencies,
# and package-lock.json is committed, so what CI installs is what was tested. This lives in the
# repository rather than in anybody's shell history because an install flag that only exists on
# one machine is a build that only works on one machine.
legacy-peer-deps=true

# Audit and funding output on every install, in a package with no runtime dependencies, is noise
# that trains people to ignore install output. CI runs `npm audit` as its own step instead.
audit=false
fund=false

# Disable dependency lifecycle hooks unless a reviewed exception is required.
ignore-scripts=true
