    {
      "kind": "message",
      "id": "note.outbound",
      "version": 1,
      "description": "Stellar to EVM note: version, twenty byte EVM recipient, eight byte nonce",
      "size": {
        "kind": "fixed",
        "bytes": 29
      },
      "fields": [
        {
          "name": "version",
          "encoding": "uint",
          "offset": 0,
          "length": 1,
          "constant": 1
        },
        {
          "name": "recipient",
          "encoding": "bytes",
          "offset": 1,
          "length": 20
        },
        {
          "name": "nonce",
          "encoding": "uint",
          "offset": 21,
          "length": 8
        }
      ]
    },
    {
      "kind": "message",
      "id": "note.inbound",
      "version": 1,
      "description": "EVM to Stellar note: version, address kind, strkey length, ascii strkey, nonce",
      "size": {
        "kind": "one-of",
        "bytes": [
          67,
          80
        ]
      },
      "fields": [
        {
          "name": "version",
          "encoding": "uint",
          "offset": 0,
          "length": 1,
          "constant": 1
        },
        {
          "name": "kind",
          "encoding": "uint",
          "offset": 1,
          "length": 1,
          "values": {
            "account": 0,
            "contract": 1,
            "muxed": 2
          }
        },
        {
          "name": "strkeyLength",
          "encoding": "uint",
          "offset": 2,
          "length": 1,
          "values": {
            "plain": 56,
            "muxed": 69
          }
        },
        {
          "name": "strkey",
          "encoding": "ascii",
          "offset": 3,
          "length": {
            "from": "strkeyLength"
          }
        },
        {
          "name": "nonce",
          "encoding": "uint",
          "offset": {
            "after": "strkey"
          },
          "length": 8
        }
      ]
    },
    {
      "kind": "message",
